# Copy to .env on the VPS and fill in real values. Never commit .env.
GATEWAY_TOKEN=super-secret-gateway-token
WEB_USERNAME=admin
WEB_PASSWORD=change-me
# Optional. Database backend: sqlite (default), mysql, or postgres.
# DB_DRIVER=postgres
# DB_DSN=postgres://szx_gateway:change-me@postgres-host:5432/szx_gateway?sslmode=disable
# DB_DRIVER=mysql
# DB_DSN=szx_gateway:change-me@tcp(mysql-host:3306)/szx_gateway?parseTime=true&loc=UTC&charset=utf8mb4
# AIHubMix proxy listens on a separate port (default :8081) so it doesn't
# collide with the OpenRouter endpoint on :8080. Both share the same admin UI.
AIHUBMIX_LISTEN_ADDR=:8081
# Google AI Studio proxy on :8082.
GOOGLE_LISTEN_ADDR=:8082
# Logs are written to ./logs/gateway.log and rotated when reaching this limit.
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
