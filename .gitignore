# Binaries
/build/
*.exe
*.exe~
*.dll
*.so
*.dylib
/gateway

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Private keys (CRITICAL FOR SECURITY)
accounts/api_keys.txt
.env

# Worktrees
/.worktrees/
.opencode/

# SPA build artifacts (встроенный UI генерится Vite, не коммитится)
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# OS/IDEs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
/agents.local.md

# Impeccable runtime state
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/*.png
